# ========================================================
# CloudSecure File Transfer - Environment Variables Template
# Copy this file to .env and replace with your actual values:
# copy .env.example .env
# ========================================================

# Flask Secret Key for session signing
FLASK_SECRET_KEY=change-this-in-production-to-a-random-secret-key

# Storage Mode: 'local' (Phase 1, ₹0) or 's3' (Phase 2, AWS)
STORAGE_MODE=local

# AES Encryption Key (Generate using: python generate_key.py)
# Format: 32 url-safe base64-encoded bytes (Fernet key)
SECRET_ENCRYPTION_KEY=

# Maximum upload file size in Megabytes (default: 16 MB)
MAX_UPLOAD_SIZE_MB=16

# AWS S3 Settings (Used ONLY in Phase 2 - Leave empty for Phase 1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
